! =====================================================================
!  Spanish for morph-fst: the hand-written half of spanish.morph
! ---------------------------------------------------------------------
!  Function words and context rules. The open classes (nouns,
!  adjectives, verbs) are generated from the RLA-ES Hunspell dictionary
!  by examples/build_spanish.rs at the GENERATED marker below.
!  Regenerate data/spanish.morph after editing this file.
! =====================================================================

OPTION max_morph_chars 48

! ---------------------------------------------------------------------
!  Context: learned by `cargo run --release --example treebank -- learn`
!  on UD Spanish AnCora train, stopped on dev. The first rule that
!  applies decides; "x" is a lemma.
! ---------------------------------------------------------------------
PREFER CONJ AFTER V
PREFER CONJ AFTER ADP
PREFER ADJ OVER N AFTER N
PREFER N AFTER DET
PREFER V AFTER PRON
PREFER CONJ BEFORE DET
PREFER PRON BEFORE V
PREFER ADJ OVER N AFTER ADV
PREFER CONJ AFTER ADV
PREFER PRON BEFORE PRON
PREFER N BEFORE PUNCT
PREFER N BEFORE NAME
PREFER CONJ AFTER CONJ
PREFER ADV BEFORE ADV
PREFER N BEFORE "y"

LEXICON Root
  0 Closed ;
  0 Irregular ;
  0 Words ;

! surface:lemma pairs list a form under its lemma (la -> el)
LEXICON Closed
  el          DET   # ;
  la:el       DET   # ;
  los:el      DET   # ;
  las:el      DET   # ;
  lo:el       DET   # ;
  un:uno      DET   # ;
  una:uno     DET   # ;
  unos:uno    DET   # ;
  unas:uno    DET   # ;
  este        DET   # ;
  esta:este   DET   # ;
  estos:este  DET   # ;
  estas:este  DET   # ;
  ese         DET   # ;
  esa:ese     DET   # ;
  esos:ese    DET   # ;
  esas:ese    DET   # ;
  aquel       DET   # ;
  aquella:aquel   DET  # ;
  aquellos:aquel  DET  # ;
  aquellas:aquel  DET  # ;
  su          DET   # ;
  sus:su      DET   # ;
  mi          DET   # ;
  mis:mi      DET   # ;
  tu          DET   # ;
  tus:tu      DET   # ;
  nuestro     DET   # ;
