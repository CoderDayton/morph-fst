  varios:vario    DET  # ;
  varias:vario    DET  # ;
  algún:alguno    DET  # ;
  alguna:alguno   DET  # ;
  algunos:alguno  DET  # ;
  algunas:alguno  DET  # ;
  ningún:ninguno  DET  # ;
  ninguna:ninguno DET  # ;
  ambos       DET   # ;
  ambas:ambos DET   # ;
  cuyo        DET   # ;
  cuya:cuyo   DET   # ;
  qué         DET   # ;
  cuánto      DET   # ;

  yo          PRON  # ;
  tú          PRON  # ;
  él          PRON  # ;
