  twice        ADV    # ;
  zero         NUM    # ;
  two          NUM    # ;
  three        NUM    # ;
  four         NUM    # ;
  five         NUM    # ;
  six          NUM    # ;
  seven        NUM    # ;
  eight        NUM    # ;
  nine         NUM    # ;
  ten          NUM    # ;
  eleven       NUM    # ;
  twelve       NUM    # ;
  thirteen     NUM    # ;
  fourteen     NUM    # ;
  fifteen      NUM    # ;
  sixteen      NUM    # ;
  seventeen    NUM    # ;
  eighteen     NUM    # ;
  nineteen     NUM    # ;
  twenty       NUM    # ;
  thirty       NUM    # ;
  forty        NUM    # ;
  fifty        NUM    # ;
  sixty        NUM    # ;
  seventy      NUM    # ;
  eighty       NUM    # ;
  ninety       NUM    # ;
  hundred      NUM    # ;
  thousand     NUM    # ;
  million      NUM    # ;
  billion      NUM    # ;
  first        NUM    # ;
  second       NUM    # ;
  third        NUM    # ;
  can          MOD    # ;
