! =====================================================================
!  English grammar for morph-fst: the hand-written half of english.morph
! ---------------------------------------------------------------------
!  Affixes, spelling rules and function words. The open-class lexicon
!  (nouns, verbs, adjectives, adverbs) and every irregular form are
!  generated from ESDB by examples/build_english.rs at the GENERATED
!  marker below; each word gets the class that reproduces its ESDB
!  inflections. Regenerate data/english.morph after editing this file.
!
!  LEXICON Name [@open=TAG]        @open: hybrid mode may posit an
!                                  unknown stem of this class (?TAG)
!    surface[:lemma] TAG Cont [@flag ...] ;
!    0 Cont ;                      epsilon continuation
!    #                             end of word
!  RULES   name: TARGET -> REPL / [C|V|^] _ +{next,...} [@flag] ;
!          TARGET `.` = any last char; REPL `0` = delete, `$` = target
!  PIECES  extra WordPiece units (##x = word-internal)
!  Comments start with `!`.
! =====================================================================

OPTION max_morph_chars 48
OPTION derivation PFX,NMLZ,ADJZ,VBZ,AGENT,ABLE,ADV

LEXICON Root
  0 Prefixes ;
  0 Stems ;
  0 Closed ;
  0 Irregular ;
  0 Adverbs ;

LEXICON Stems
  0 NounStems ;
  0 VerbStems ;
  0 AdjStems ;

! ---------------------------------------------------------------------
!  Derivational prefixes
! ---------------------------------------------------------------------
LEXICON Prefixes
  un     PFX:NEG      AdjStems ;
  un     PFX:REV      VerbStems ;
  in     PFX:NEG      AdjStems ;
  im     PFX:NEG      AdjStems ;
  non    PFX:NEG      AdjStems ;
  non    PFX:NEG      NounStems ;
  re     PFX:AGAIN    VerbStems ;
  dis    PFX:NEG      VerbStems ;
  mis    PFX:WRONG    VerbStems ;
  pre    PFX:BEFORE   VerbStems ;
  over   PFX:EXCESS   VerbStems ;
  under  PFX:INSUFF   VerbStems ;
  out    PFX:SURPASS  VerbStems ;
  co     PFX:JOINT    VerbStems ;
  anti   PFX:AGAINST  NounStems ;
  super  PFX:ABOVE    NounStems ;
  sub    PFX:BELOW    NounStems ;
  inter  PFX:BETWEEN  NounStems ;
  micro  PFX:SMALL    NounStems ;
  self   PFX:SELF     NounStems ;

! ---------------------------------------------------------------------
!  Function words
! ---------------------------------------------------------------------
LEXICON Closed
  the          DET    # ;
  a            DET    # ;
  an:a         DET    # ;
  this         DET    # ;
  that         DET    # ;
  these:this   DET    # ;
  those:that   DET    # ;
  some         DET    # ;
  any          DET    # ;
  every        DET    # ;
  each         DET    # ;
  no           DET    # ;
  all          DET    # ;
  both         DET    # ;
  either       DET    # ;
  neither      DET    # ;
  few          DET    # ;
  several      DET    # ;
  such         DET    # ;
  what         DET    # ;
  which        DET    # ;
  whose        DET    # ;
  another      DET    # ;
  much         DET    # ;
  many         DET    # ;
  i            PRON   # ;
  me:i         PRON   # ;
  my           PRON   # ;
  mine:my      PRON   # ;
  myself       PRON   # ;
  you          PRON   # ;
  your         PRON   # ;
  yours        PRON   # ;
  yourself     PRON   # ;
  yourselves   PRON   # ;
  he           PRON   # ;
  him:he       PRON   # ;
  his          PRON   # ;
  himself      PRON   # ;
  she          PRON   # ;
  her:she      PRON   # ;
  hers         PRON   # ;
  herself      PRON   # ;
  it           PRON   # ;
  its          PRON   # ;
  itself       PRON   # ;
  we           PRON   # ;
  us:we        PRON   # ;
  our          PRON   # ;
  ours         PRON   # ;
  ourselves    PRON   # ;
  they         PRON   # ;
  them:they    PRON   # ;
  their        PRON   # ;
  theirs       PRON   # ;
  themselves   PRON   # ;
  who          PRON   # ;
  whom         PRON   # ;
  one          PRON   # ;
  someone      PRON   # ;
  somebody     PRON   # ;
  something    PRON   # ;
  anyone       PRON   # ;
  anybody      PRON   # ;
  anything     PRON   # ;
  everyone     PRON   # ;
  everybody    PRON   # ;
  everything   PRON   # ;
  nobody       PRON   # ;
  nothing      PRON   # ;
  none         PRON   # ;
  of           PREP   # ;
  to           PREP   # ;
  in           PREP   # ;
  on           PREP   # ;
  at           PREP   # ;
  with         PREP   # ;
  for          PREP   # ;
  from         PREP   # ;
  by           PREP   # ;
  about        PREP   # ;
  above        PREP   # ;
  across       PREP   # ;
  after        PREP   # ;
  against      PREP   # ;
  along        PREP   # ;
  among        PREP   # ;
  around       PREP   # ;
  before       PREP   # ;
  behind       PREP   # ;
  below        PREP   # ;
  beneath      PREP   # ;
  beside       PREP   # ;
  besides      PREP   # ;
  between      PREP   # ;
  beyond       PREP   # ;
  despite      PREP   # ;
  down         PREP   # ;
  during       PREP   # ;
  except       PREP   # ;
  inside       PREP   # ;
  into         PREP   # ;
  like         PREP   # ;
  near         PREP   # ;
  off          PREP   # ;
  onto         PREP   # ;
  opposite     PREP   # ;
  outside      PREP   # ;
  over         PREP   # ;
  past         PREP   # ;
  per          PREP   # ;
  round        PREP   # ;
