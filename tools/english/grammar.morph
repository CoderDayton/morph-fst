  than         PREP   # ;
  through      PREP   # ;
  throughout   PREP   # ;
  toward       PREP   # ;
  towards      PREP   # ;
  under        PREP   # ;
  underneath   PREP   # ;
  unlike       PREP   # ;
  until        PREP   # ;
  up           PREP   # ;
  upon         PREP   # ;
  via          PREP   # ;
  within       PREP   # ;
  without      PREP   # ;
  and          CONJ   # ;
  or           CONJ   # ;
  but          CONJ   # ;
  nor          CONJ   # ;
  so           CONJ   # ;
  as           PREP   # ;
  yet          CONJ   # ;
  because      CONJ   # ;
  although     CONJ   # ;
  though       CONJ   # ;
  unless       CONJ   # ;
  whereas      CONJ   # ;
  whether      CONJ   # ;
  while        CONJ   # ;
  if           CONJ   # ;
  not          ADV    # ;
  never        ADV    # ;
  always       ADV    # ;
  often        ADV    # ;
  sometimes    ADV    # ;
  usually      ADV    # ;
  seldom       ADV    # ;
  rarely       ADV    # ;
  ever         ADV    # ;
  already      ADV    # ;
  also         ADV    # ;
  too          ADV    # ;
  very         ADV    # ;
  quite        ADV    # ;
  rather       ADV    # ;
  almost       ADV    # ;
  just         ADV    # ;
  only         ADV    # ;
  even         ADV    # ;
  still        ADV    # ;
  again        ADV    # ;
  here         ADV    # ;
  there        ADV    # ;
  now          ADV    # ;
  then         ADV    # ;
  today        ADV    # ;
  tomorrow     ADV    # ;
  yesterday    ADV    # ;
  soon         ADV    # ;
  later        ADV    # ;
  where        ADV    # ;
  when         ADV    # ;
  why          ADV    # ;
  how          ADV    # ;
  yes          ADV    # ;
  no           ADV    # ;
  perhaps      ADV    # ;
  maybe        ADV    # ;
  else         ADV    # ;
