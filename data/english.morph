! ---------------------------------------------------------------------
!  Noun inflection and derivation
! ---------------------------------------------------------------------
LEXICON NounCont
  0 NounInfl ;
  0 NounDeriv ;

! plural listed whole in Closed (men, feet, sheep)
LEXICON NounNoPl
  0 # ;
  0 NounDeriv ;

LEXICON NounInfl
  s     PL           # ;
  0 # ;

LEXICON NounDeriv
  ful   ADJZ:FULL    AdjDerivInfl ;
  less  ADJZ:LESS    AdjDerivInfl ;
  y     ADJZ:Y       AdjInfl ;
  ly    ADJZ:LY      AdjInfl ;
  al    ADJZ:AL      AdjDerivInfl ;
  ish   ADJZ:ISH     AdjDerivInfl ;
  ous   ADJZ:OUS     AdjDerivInfl ;
  hood  NMLZ:STATE   NounInfl ;
  ship  NMLZ:STATE   NounInfl ;
  ism   NMLZ:ISM     NounInfl ;
  ist   NMLZ:IST     NounInfl ;
  ize   VBZ:IZE      VerbInfl ;

! ---------------------------------------------------------------------
!  Verb inflection and derivation
! ---------------------------------------------------------------------
LEXICON VerbInfl
  s     3SG          # ;
  ed    PAST         # ;
  ed    PTCP         # ;
  ing   PROG         # ;
  ing   NMLZ:ING     NounInfl ;
  er    AGENT        AgentCont ;
  0 # ;

! irregular past and participle are listed in Closed: no regular -ed
LEXICON VerbIrr
  s     3SG          # ;
  ing   PROG         # ;
  ing   NMLZ:ING     NounInfl ;
  er    AGENT        AgentCont ;
  0 # ;

LEXICON VerbAble
  0 VerbInfl ;
  able  ABLE         AdjDerivInfl ;

LEXICON VerbMent
  0 VerbAble ;
  ment  NMLZ         NounInfl ;

LEXICON VerbIon
  0 VerbAble ;
  ion   NMLZ         NounInfl ;
  ive   ADJZ:IVE     AdjDerivInfl ;

LEXICON VerbAtion
  0 VerbAble ;
  ation NMLZ         NounInfl ;

LEXICON AgentCont
  0 NounInfl ;
  ship  NMLZ:STATE   NounInfl ;

! ---------------------------------------------------------------------
!  Adjective inflection and derivation
! ---------------------------------------------------------------------
LEXICON AdjInfl
  er    CMP          # ;
  est   SUP          # ;
  ly    ADV          # ;
  ness  NMLZ         NounInfl ;
  0 # ;

LEXICON AdjEn
  0 AdjInfl ;
  en    VBZ          VerbInfl ;

! long adjectives: more/most, no -er/-est
LEXICON AdjDerivInfl
  ly    ADV          # ;
  ness  NMLZ         NounInfl ;
  ity   NMLZ:ITY     NounInfl ;
  ize   VBZ:IZE      VerbInfl ;
  0 # ;

! ---------------------------------------------------------------------
!  Spelling rules (obligatory, compiled into allomorphs)
! ---------------------------------------------------------------------
RULES
