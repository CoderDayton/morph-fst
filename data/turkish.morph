! =====================================================================
!  Turkish grammar for morph-fst: the hand-written half of turkish.morph
! ---------------------------------------------------------------------
!  Suffixes, harmony, spelling rules and a few function words. The
!  lexicon (nouns, adjectives, verbs and the other word classes) is
!  generated from Zemberek-NLP (Apache-2.0) by examples/build_turkish.rs
!  at the GENERATED marker below. Regenerate data/turkish.morph after
!  editing this file.
!
!  Vowel harmony is long-distance: every suffix vowel agrees with the
!  last vowel before it, however many suffixes back. The context register
!  tracks two features of the surface text seen so far:
!     vow  : backness/rounding of the last vowel  (bu br fu fr)
!     coda : type of the last character            (v vl vd)
!  Archiphonemes in suffixes read it:
!     {A} a/e   {I} ı/i/u/ü   {Ix} {I} or nothing after a vowel
!     {D} d/t   {C} c/ç   {Y} {S} {N} buffer consonants after vowels
! =====================================================================

OPTION max_morph_chars 48
OPTION case turkish
! Listed words are not second-guessed as stem + ending (`para`, not `par` + `a`).
OPTION prefer_inflection false

! ---------------------------------------------------------------------
!  Context: learned by `cargo run --release --example treebank -- learn`
!  on UD Turkish BOUN train, stopped on dev. The first rule that applies
!  decides; "x" is a lemma.
! ---------------------------------------------------------------------
PREFER V BEFORE "."
PREFER ADV AFTER N
PREFER DET BEFORE N
PREFER ADV BEFORE V
PREFER ADV BEFORE ADJ
PREFER ADJ OVER N BEFORE "bir"
PREFER ADV BEFORE ADV
PREFER POSTP OVER N AFTER V

CLASS V        = a e ı i o ö u ü â î û
CLASS C        = b c ç d f g ğ h j k l m n p r s ş t v y z
CLASS AE       = a e
CLASS HV       = ı i u ü
CLASS VOWELISH = a e ı i o ö u ü {A} {Ax} {I} {Ix} {Y} {S} {N}

FEATURE vow
  a ı â -> bu
  o u û -> br
  e i î -> fu
  ö ü -> fr

FEATURE coda
  [V] -> v
  ç f h k p s ş t -> vl
  [*] -> vd

ARCHI A
  vow=bu|br -> a
  * -> e

! the aorist's a/e, dropped after a vowel (yap-ar, de-r)
ARCHI Ax
  coda=v -> 0
  vow=bu|br -> a
  * -> e

ARCHI I
  vow=bu -> ı
  vow=br -> u
  vow=fr -> ü
  * -> i

ARCHI Ix
  coda=v -> 0
  vow=bu -> ı
  vow=br -> u
  vow=fr -> ü
  * -> i

ARCHI D
  coda=vl -> t
  * -> d

ARCHI C
  coda=vl -> ç
  * -> c

ARCHI Y
  coda=v -> y
  * -> 0

! a buffer y before a consonant (evde-y-di, ev-di): unlike {Y}, it does not
! make the stem's final consonant voice (kitap-la, not *kitab-la)
ARCHI Yc
  coda=v -> y
  * -> 0

ARCHI S
  coda=v -> s
  * -> 0

ARCHI N
  coda=v -> n
  * -> 0

! function words first: among equal readings, the earlier lexicon wins
LEXICON Root
  0 Closed ;
  0 Words ;
  0 Nouns ;
  0 Adjs ;
  0 Verbs ;

LEXICON Closed
  ve      CONJ  # ;
  ama     CONJ  # ;
  bir     DET   # ;
  bu      DEM   Dem ;
  şu      DEM   Dem ;
  o       DEM   Dem ;
  ben     PRON  PronCase ;
  sen     PRON  PronCase ;
  bana:ben PRON DatZero ;
  sana:sen PRON DatZero ;
  biz     PRON  PronReg ;
  siz     PRON  PronReg ;
  çok     ADV   # ;
  değil   NEG   QCont ;
  mi      Q     QCont ;
  mı      Q     QCont ;
  mu      Q     QCont ;
  mü      Q     QCont ;

! bu, şu, o take a pronominal n before case (bunu, onun, şunda)
LEXICON Dem
  0 # ;
  n{I}       ACC   # ;
  n{I}n      GEN   # ;
  n{A}       DAT   # ;
  n{D}{A}    LOC   # ;
  n{D}{A}n   ABL   # ;
  n{I}nl{A}  INS   # ;
  nl{A}r     PL    Case ;

! ben and sen have their own datives (bana, sana)
LEXICON PronReg
  {Y}{A}     DAT   # ;
  0 PronCase ;

LEXICON PronCase
  0 # ;
  {I}        ACC   # ;
  {I}m       GEN   # ;
  {D}{A}     LOC   # ;
  {D}{A}n    ABL   # ;
  {I}ml{A}   INS   # ;

LEXICON DatZero
  0 DAT # ;

! the question particle and değil take person and copula (misin, değildi)
LEXICON QCont
  0 # ;
  {Y}{I}m      1SG       # ;
  s{I}n        2SG       # ;
  {Y}{I}z      1PL       # ;
  s{I}n{I}z    2PL       # ;
  {Yc}{D}{I}    PST.COP   PersK ;
  {Yc}m{I}ş     EVID.COP  PersZ ;
  {D}{I}r      COP       # ;

